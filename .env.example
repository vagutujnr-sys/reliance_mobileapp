# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Long random string used to sign mobile and admin session cookies.
# Example: openssl rand -base64 48
SESSION_SECRET=

# Set to supabase after you apply supabase/migrations and supabase/seed.sql.
# Leave unset to run the local demonstration dataset.
RMS_DATA_SOURCE=
